---
import AuthLayout from '@/layouts/AuthLayout.astro';

const token = Astro.url.searchParams.get('token') || '';
---

<AuthLayout title="Reset Password — Business HQ">
  <h1 class="auth-title">Set a new password</h1>
  <p class="auth-subtitle">Choose a new password for your account</p>

  {!token && <div class="auth-error">Invalid reset link. Please request a new one.</div>}

  {token && (
    <form class="auth-form" method="POST" action="/api/auth/reset-password">
      <input type="hidden" name="token" value={token} />
      <label class="auth-field">
        <span>New password</span>
        <input type="password" name="password" required placeholder="At least 8 characters" autocomplete="new-password" minlength="8" />
      </label>
      <button type="submit" class="btn btn-primary auth-btn">Reset password</button>
    </form>
  )}

  <div class="auth-footer">
    <a href="/login">Back to sign in</a>
  </div>
</AuthLayout>
