---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db, schema } from '@/lib/db';
import { eq } from 'drizzle-orm';

const token = Astro.url.searchParams.get('token') || '';

let invitation = null;
let error = null;

if (token) {
  const rows = await db
    .select({
      invitation: schema.invitations,
      workspace: schema.workspaces,
    })
    .from(schema.invitations)
    .innerJoin(schema.workspaces, eq(schema.workspaces.id, schema.invitations.workspaceId))
    .where(eq(schema.invitations.token, token))
    .limit(1);

  if (rows.length === 0) {
    error = 'Invalid invitation link.';
  } else if (rows[0].invitation.status === 'revoked') {
    error = 'This invitation has been revoked.';
  } else if (rows[0].invitation.status === 'accepted') {
    error = 'This invitation has already been accepted.';
  } else {
    invitation = {
      workspaceName: rows[0].workspace.name,
      email: rows[0].invitation.email,
      role: rows[0].invitation.role,
    };
  }
}
---

<BaseLayout title="Invitation — Business HQ">
  <div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px;">
    <div style="width:100%; max-width:420px; background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:32px 28px; box-shadow:0 20px 55px rgba(53,38,88,.18), 0 0 0 1px rgba(102,78,154,.08);">
      <div style="display:flex; align-items:center; gap:10px; justify-content:center; margin-bottom:24px;">
        <div class="brand-mark">HQ</div>
        <span style="font-weight:600; font-size:17px;">Business HQ</span>
      </div>

      {error && <div style="background:var(--red-soft); color:var(--red); border-radius:8px; padding:10px 14px; font-size:12.5px; font-weight:500;">{error}</div>}

      {invitation && (
        <>
          <h1 style="font-size:18px; font-weight:600; text-align:center; margin-bottom:6px;">You're invited!</h1>
          <p style="font-size:13px; color:var(--text-tertiary); text-align:center; margin-bottom:22px;">
            You've been invited to join <strong>{invitation.workspaceName}</strong> as a <strong>{invitation.role}</strong>.
          </p>
          {Astro.locals.user ? (
            <form method="POST" action="/api/invitations/accept">
              <input type="hidden" name="token" value={token} />
              <button type="submit" class="btn btn-primary" style="width:100%; padding:10px 18px; font-size:13.5px;">Accept invitation</button>
            </form>
          ) : (
            <div style="text-align:center;">
              <p style="font-size:13px; color:var(--text-tertiary); margin-bottom:16px;">Sign in or create an account to accept this invitation.</p>
              <a href={`/login?redirect=${encodeURIComponent('/invitation?token=' + token)}`} class="btn btn-primary" style="display:inline-block; padding:10px 18px; font-size:13.5px; text-decoration:none;">Sign in</a>
              <span style="margin:0 8px; color:var(--text-tertiary);">or</span>
              <a href={`/signup?redirect=${encodeURIComponent('/invitation?token=' + token)}`} class="btn btn-secondary" style="display:inline-block; padding:10px 18px; font-size:13.5px; text-decoration:none;">Sign up</a>
            </div>
          )}
        </>
      )}

      {!token && (
        <>
          <h1 style="font-size:18px; font-weight:600; text-align:center; margin-bottom:6px;">Invitation</h1>
          <p style="font-size:13px; color:var(--text-tertiary); text-align:center;">No invitation token provided.</p>
        </>
      )}
    </div>
  </div>
</BaseLayout>
