---
interface Props {
  activeSection: string;
  ownerName: string;
  ownerInitials: string;
  role: string;
}

const { activeSection, ownerName, ownerInitials, role } = Astro.props;

const navItems = [
  { section: 'dashboard', label: 'Dashboard', href: '/', icon: 'M3 13h8V3H3v10Zm0 8h8v-6H3v6Zm10 0h8V11h-8v10Zm0-18v6h8V3h-8Z' },
  { section: 'chat-ai', label: 'Chat with AI', href: '/chat-ai', icon: 'M4 5.5h16A1.5 1.5 0 0 1 21.5 7v9A1.5 1.5 0 0 1 20 17.5h-9L6 21v-3.5H4A1.5 1.5 0 0 1 2.5 16V7A1.5 1.5 0 0 1 4 5.5Z', chat: true },
  { section: 'calendar', label: 'Calendar', href: '/calendar', icon: 'M7 2v2M17 2v2M3.5 8.5h17M4 4.5h16A1.5 1.5 0 0 1 21.5 6v14A1.5 1.5 0 0 1 20 21.5H4A1.5 1.5 0 0 1 2.5 20V6A1.5 1.5 0 0 1 4 4.5Z' },
  { section: 'video-ideas', label: 'Video Ideas', href: '/video-ideas', icon: 'M4 6.5A1.5 1.5 0 0 1 5.5 5h9A1.5 1.5 0 0 1 16 6.5v11A1.5 1.5 0 0 1 14.5 19h-9A1.5 1.5 0 0 1 4 17.5v-11Z', icon2: 'm16 10 4.2-2.4a.6.6 0 0 1 .9.52v7.76a.6.6 0 0 1-.9.52L16 14' },
  { section: 'pre-orders', label: 'Pre-Orders', href: '/pre-orders', icon: 'M3 7h18M3 7l1.4 11.2A2 2 0 0 0 6.4 20h11.2a2 2 0 0 0 2-1.8L21 7M8 7V5a4 4 0 0 1 8 0v2' },
  { section: 'customer-updates', label: 'Customer Updates', href: '/customer-updates', icon: 'M4 5.5h16A1.5 1.5 0 0 1 21.5 7v10A1.5 1.5 0 0 1 20 18.5H4A1.5 1.5 0 0 1 2.5 17V7A1.5 1.5 0 0 1 4 5.5Z', icon2: 'm3 7 9 6 9-6' },
  { section: 'sales', label: 'Sales', href: '/sales', icon: 'M4 19V10M10 19V5M16 19v-7M22 19H2' },
  { section: 'notes', label: 'Notes', href: '/notes', icon: 'M6 3.5h12A1.5 1.5 0 0 1 19.5 5v14A1.5 1.5 0 0 1 18 20.5H6A1.5 1.5 0 0 1 4.5 19V5A1.5 1.5 0 0 1 6 3.5Z', icon2: 'M8 8h8M8 12h8M8 16h5' },
  { section: 'important-emails', label: 'Important Emails', href: '/important-emails', icon: 'M3.5 6.5h17v11a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1v-11Z', icon2: 'm4 7 8 6.5L20 7' },
  { section: 'bulk-orders', label: 'Bulk Orders', href: '/bulk-orders', icon: 'M3 8.5 12 4l9 4.5-9 4.5-9-4.5Z', icon2: 'M3 8.5V16l9 4.5 9-4.5V8.5' },
  { section: 'cost-profit', label: 'Cost & Profit', href: '/cost-profit', icon: 'M12 7.5v9M14.8 9.8c0-1.1-1.25-2-2.8-2s-2.8.9-2.8 2c0 1.1 1.25 1.6 2.8 1.9 1.55.3 2.8.9 2.8 2 0 1.1-1.25 2-2.8 2s-2.8-.9-2.8-2', circle: true },
  { section: 'samples', label: 'Samples', href: '/samples', icon: 'M9 3h6l1 5-4 12-4-12 1-5Z', icon2: 'M8 8h8' },
  { section: 'tracking', label: 'Tracking', href: '/tracking', icon: 'M3 16.5V6.5A1.5 1.5 0 0 1 4.5 5H13a1.5 1.5 0 0 1 1.5 1.5v10M3 16.5A1.5 1.5 0 0 0 4.5 18h1M3 16.5h11.5M14.5 8h3.2a1 1 0 0 1 .85.47l2.1 3.36a1 1 0 0 1 .15.53V16a1 1 0 0 1-1 1h-.8', circles: ['7.5 18 1.7', '17.5 18 1.7'] },
];
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-mark">HQ</div>
    <span class="brand-name">Business HQ</span>
  </div>

  <nav class="nav">
    {navItems.map((item) => (
      <a
        class={`nav-item ${activeSection === item.section ? 'active' : ''}`}
        href={item.href}
        title={item.label}
        aria-label={item.label}
        data-section={item.section}
      >
        {item.circle ? (
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke-width="1.6" />
            <path d={item.icon} fill="none" stroke-width="1.6" />
          </svg>
        ) : item.circles ? (
          <svg viewBox="0 0 24 24">
            <path d={item.icon} fill="none" stroke-width="1.6" />
            <circle cx="7.5" cy="18" r="1.7" fill="none" stroke-width="1.6" />
            <circle cx="17.5" cy="18" r="1.7" fill="none" stroke-width="1.6" />
          </svg>
        ) : item.chat ? (
          <svg viewBox="0 0 24 24">
            <path d={item.icon} fill="none" stroke-width="1.6" />
            <circle cx="8" cy="11" r="1" />
            <circle cx="12" cy="11" r="1" />
            <circle cx="16" cy="11" r="1" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24">
            <path d={item.icon} fill="none" stroke-width="1.6" />
            {item.icon2 && <path d={item.icon2} fill="none" stroke-width="1.6" />}
          </svg>
        )}
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <div class="sidebar-footer">
    <a class="nav-item" href="/settings" title="Settings" aria-label="Settings" data-section="settings">
      <svg viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="3" fill="none" stroke-width="1.6" />
        <path d="M19.4 13.5a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V19.5a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1-1.56 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H4.5a2 2 0 1 1 0-4h.09a1.7 1.7 0 0 0 1.56-1 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34H10a1.7 1.7 0 0 0 1-1.55V4.5a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87V10a1.7 1.7 0 0 0 1.55 1h.09a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1Z" fill="none" stroke-width="1.3" />
      </svg>
      <span>Settings</span>
    </a>
    <div class="owner-card">
      <div class="avatar">{ownerInitials}</div>
      <div>
        <div class="owner-name">{ownerName}</div>
        <div class="owner-role">{role}</div>
      </div>
    </div>
  </div>
</aside>
