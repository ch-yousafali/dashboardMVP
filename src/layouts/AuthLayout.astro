---
import '@/styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Business HQ' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="auth-shell">
      <div class="auth-card">
        <div class="auth-brand">
          <div class="brand-mark">HQ</div>
          <span class="brand-name">Business HQ</span>
        </div>
        <slot />
      </div>
    </div>
  </body>
</html>
